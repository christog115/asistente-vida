{
  "name": "asistente-vida",
  "version": "0.2.1",
  "description": "Tablero de vida personal: correo, calendario, tareas de la escuela y recordatorios diarios en una app de escritorio.",
  "main": "main.js",
  "author": "Christopher",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.1",
    "adm-zip": "^0.5.18",
    "electron-updater": "^6.8.11",
    "googleapis": "^185.0.0",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "mx.christopher.asistente-vida",
    "productName": "Asistente de Vida",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "christog115",
        "repo": "asistente-vida",
        "releaseType": "release"
      }
    ]
  }
}
